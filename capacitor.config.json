{
	"appId": "com.agnus.app",
	"appName": "Agnus",
	"webDir": "dist",
	"ios": {
		"contentInset": "automatic",
		"preferredContentMode": "mobile",
		"scheme": "capacitor"
	},
	"server": {
		"hostname": "localhost"
	},
	"packageClassList": [
		"FirebaseAuthenticationPlugin"
	],
	"plugins": {
		"FirebaseAuthentication": {
			"skipNativeAuth": false,
			"providers": [
				"google.com"
			]
		}
	}
}

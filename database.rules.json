{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "admin": {
          ".write": false
        },
        "email": {
          ".read": "auth != null"
        },
        "username": {
          ".read": "auth != null"
        },
        "profilePicture": {
          ".read": "auth != null"
        }
      }
    },
    "usernameIndex": {
      "$usernameKey": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isString()"
      }
    },
    "emailIndex": {
      "$emailKey": {
        ".read": "auth != null",
        ".write": "auth != null",
        ".validate": "newData.isString()"
      }
    },
    "friends": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$friendUid": {
          ".write": "auth != null && (auth.uid === $uid || auth.uid === $friendUid)"
        }
      }
    },
    "notifications": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$notifId": {
          ".write": "auth != null"
        }
      }
    },
    "userCoopSessions": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        "$sessionId": {
          ".write": "auth != null"
        }
      }
    },
    "coopSessions": {
      "$sessionId": {
        ".read": "auth != null",
        ".write": "auth != null && (!data.exists() || data.child('hostUid').val() === auth.uid || data.child('guestUid').val() === auth.uid || data.child('guestUid').val() === null)"
      }
    },
    "adminIndex": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && root.child('users/' + auth.uid + '/admin').val() === true"
      }
    },
    "presence": {
      ".read": "auth != null && root.child('users/' + auth.uid + '/admin').val() === true",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "publicStats": {
      ".read": "auth != null",
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "puzzleCompletions": {
      "$mode": {
        "$puzzleKey": {
          ".read": "auth != null",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid"
          }
        }
      }
    },
    "mosaics": {
      "pending": {
        ".read": "auth != null && root.child('users/' + auth.uid + '/admin').val() === true",
        "$mosaicId": {
          ".write": "auth != null"
        }
      },
      "public": {
        ".read": true,
        "$mosaicId": {
          ".write": "auth != null && root.child('users/' + auth.uid + '/admin').val() === true"
        }
      },
      "meta": {
        ".read": true,
        ".write": "auth != null && root.child('users/' + auth.uid + '/admin').val() === true"
      },
      "shared": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid",
          "$mosaicId": {
            ".write": "auth != null"
          }
        }
      }
    }
  }
}
